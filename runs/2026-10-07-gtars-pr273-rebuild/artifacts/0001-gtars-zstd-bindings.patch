From 7831e09f596042e3983c7a123c3f6c019ca6c05f Mon Sep 17 00:00:00 2001
From: Kyle Ferriter <kferrite@broadinstitute.org>
Date: Tue, 6 Oct 2026 16:57:04 -0400
Subject: [PATCH] Handle StorageMode::Zstd in the Python and R bindings

The zstd storage mode added a third StorageMode variant, but the Python
and R bindings still matched only Raw and Encoded, so gtars-py and gtars-r
failed to compile with E0004 (non-exhaustive patterns).

- gtars-python: add Zstd to PyStorageMode and to both From conversions;
  declare it in the type stub.
- gtars-r: map StorageMode::Zstd to "zstd" in get_storage_mode_store.

gtars-py checked with `cargo check -p gtars-py`. gtars-r was not compiled
locally (no R toolchain available).
---
 gtars-python/py_src/gtars/refget/__init__.pyi | 2 ++
 gtars-python/src/refget/mod.rs                | 4 ++++
 gtars-r/src/rust/src/refget.rs                | 1 +
 3 files changed, 7 insertions(+)

diff --git a/gtars-python/py_src/gtars/refget/__init__.pyi b/gtars-python/py_src/gtars/refget/__init__.pyi
index 0dfeb298..b89e0f34 100644
--- a/gtars-python/py_src/gtars/refget/__init__.pyi
+++ b/gtars-python/py_src/gtars/refget/__init__.pyi
@@ -387,10 +387,12 @@ class StorageMode(Enum):
     Variants:
         Raw: Store sequences as raw bytes (1 byte per base).
         Encoded: Store sequences with 2-bit encoding (4 bases per byte).
+        Zstd: Store each sequence as a zstd-compressed frame.
     """
 
     Raw: int
     Encoded: int
+    Zstd: int
 
 class FhrMetadata:
     """FAIR Headers Reference genome metadata for a sequence collection.
diff --git a/gtars-python/src/refget/mod.rs b/gtars-python/src/refget/mod.rs
index 1171718f..500c42dd 100644
--- a/gtars-python/src/refget/mod.rs
+++ b/gtars-python/src/refget/mod.rs
@@ -1143,11 +1143,13 @@ impl From<SequenceCollection> for PySequenceCollection {
 /// Variants:
 ///     Raw: Store sequences as raw bytes (1 byte per base).
 ///     Encoded: Store sequences with 2-bit encoding (4 bases per byte).
+///     Zstd: Store each sequence as a zstd-compressed frame.
 #[pyclass(name = "StorageMode", module = "gtars.refget")]
 #[derive(Clone)]
 pub enum PyStorageMode {
     Raw,
     Encoded,
+    Zstd,
 }
 
 impl From<StorageMode> for PyStorageMode {
@@ -1155,6 +1157,7 @@ impl From<StorageMode> for PyStorageMode {
         match mode {
             StorageMode::Raw => PyStorageMode::Raw,
             StorageMode::Encoded => PyStorageMode::Encoded,
+            StorageMode::Zstd => PyStorageMode::Zstd,
         }
     }
 }
@@ -1164,6 +1167,7 @@ impl From<PyStorageMode> for StorageMode {
         match mode {
             PyStorageMode::Raw => StorageMode::Raw,
             PyStorageMode::Encoded => StorageMode::Encoded,
+            PyStorageMode::Zstd => StorageMode::Zstd,
         }
     }
 }
diff --git a/gtars-r/src/rust/src/refget.rs b/gtars-r/src/rust/src/refget.rs
index 87587398..cacb305d 100644
--- a/gtars-r/src/rust/src/refget.rs
+++ b/gtars-r/src/rust/src/refget.rs
@@ -158,6 +158,7 @@ pub fn get_storage_mode_store(store_ptr: Robj) -> extendr_api::Result<String> {
         Ok(match store.storage_mode() {
             StorageMode::Raw => "raw".to_string(),
             StorageMode::Encoded => "encoded".to_string(),
+            StorageMode::Zstd => "zstd".to_string(),
         })
     })
 }
