# Build outputs and download cache (large; regenerated by build_store.py)
/store*/
/downloads*/
*.part

# The dev manifest's lock is a local build artifact, regenerated in minutes.
# sources.dev.toml itself is tracked -- it is the manifest, not the output.
/build.dev.lock.json

# Legacy root-level generated artifacts (regenerable; large or machine-only).
# Compact summaries belong in runs/ and are intentionally visible to Git.
/build_full.log
/parity_by_digest.tsv
/parity_summary.md
/build_gaps.tsv
/seqrepo_equivalence_report.json
/.probe_cache/
sources.toml.bak.*

# Run records are retained, but reproducible bulk tables/caches are not.
/runs/**/parity_by_digest.tsv
/runs/**/parity_by_alias.tsv
/runs/**/build_gaps.tsv
/runs/**/categorized_build_gaps.tsv
/runs/**/shared_alias_mismatches.tsv
/runs/**/mismatch-diagnosis.tsv
/runs/**/store_only_contributions.tsv
/runs/**/source_contribution_summary.tsv
/runs/**/source-inventory.tsv
/runs/**/ncbi-source-catalog.jsonl
# compare_inventories.py: the per-sequence and per-alias listings are bulk; its
# numbered summary tables (00-03, 07) are small and stay visible.
/runs/**/04_sequences_seqrepo_only.tsv
/runs/**/05_sequences_store_only.tsv
/runs/**/06_sequences_shared.tsv
/runs/**/08_alias_differences.tsv
/runs/**/*.log
/runs/**/.probe_cache/
/runs/**/*.fasta
/runs/**/*.fa
/runs/**/*.fa.gz

# Local-only working notes / one-off analysis (kept on disk, not part of the repo)
# Drafted upstream bug reports stay local until they are actually filed; the
# findings they rest on live in runs/ and seqrepo_equivalence/, which are tracked.
/ISSUE-gtars-encoder-alphabet.md
/TODO.md
/UPLOAD_PLAN.md
/SEQREPO_PARITY.md
/parity_membership.py
/probe_source_coverage.py

# Python
__pycache__/
*.py[cod]
.venv/
venv/
